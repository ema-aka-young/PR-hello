# Required: GitHub personal access token (needs 'repo' scope for private repos, or no scope for public)
GITHUB_TOKEN=ghp_your_token_here

# Optional: Override target repository (default: RedHatQE/openshift-virtualization-tests)
# GITHUB_REPO=RedHatQE/openshift-virtualization-tests

# Optional: Cache TTL in seconds (default: 120)
# CACHE_TTL_SECONDS=120
